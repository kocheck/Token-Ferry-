{
  "name": "token-ferry",
  "version": "1.0.0",
  "description": "Ferry tokens back and forth to GitHub from Figma",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ shared/",
    "lint:fix": "eslint src/ shared/ --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@figma/plugin-typings": "^1.100.0",
    "esbuild": "^0.24.0",
    "eslint": "^10.0.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.0.18"
  },
  "license": "MIT"
}
